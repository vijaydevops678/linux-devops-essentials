# Sample sshd_config with typical default settings, for practising with
# ssh-hardening-check.sh:  ./ssh-hardening-check.sh -f sample-sshd_config

Include /etc/ssh/sshd_config.d/*.conf

Port 22
#PermitRootLogin prohibit-password
PermitRootLogin yes
#MaxAuthTries 6
PubkeyAuthentication yes
PasswordAuthentication yes
PermitEmptyPasswords no
KbdInteractiveAuthentication no
UsePAM yes
X11Forwarding yes
PrintMotd no
AcceptEnv LANG LC_*
Subsystem sftp /usr/lib/openssh/sftp-server
